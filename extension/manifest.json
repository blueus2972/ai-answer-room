{
 "manifest_version":3,"name":"우리반 AI 비교 연결","version":"0.2.0","minimum_chrome_version":"114",
 "description":"우리반 AI 답변 비교실에서 질문을 보내고 로그인된 Gemini, Claude, ChatGPT, Grok 답변을 가져옵니다.",
 "permissions":["storage","alarms"],
 "host_permissions":["https://uriban-ai-compare.vercel.app/*","https://gemini.google.com/*","https://claude.ai/*","https://chatgpt.com/*","https://grok.com/*"],
 "background":{"service_worker":"background.js","type":"module"},
 "action":{"default_popup":"popup.html","default_title":"우리반 AI 비교 연결"},
 "content_scripts":[
  {"matches":["https://uriban-ai-compare.vercel.app/compare","https://uriban-ai-compare.vercel.app/compare?*","https://uriban-ai-compare.vercel.app/compare.html*"],"js":["bridge.js"],"run_at":"document_idle"},
  {"matches":["https://gemini.google.com/*","https://claude.ai/*","https://chatgpt.com/*","https://grok.com/*"],"js":["provider.js"],"run_at":"document_idle"}
 ]
}
